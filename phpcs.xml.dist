<?xml version="1.0"?>
<ruleset name="Groundskeeper">
	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="extensions" value="php"/>

	<config name="minimum_supported_wp_version" value="6.0"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!-- PSR-4 class files, not WordPress's class-foo.php naming. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- WP-CLI parses these docblocks for help text; @param tags would show up there. -->
		<exclude name="Squiz.Commenting.FunctionComment"/>
		<exclude name="Squiz.Commenting.FunctionCommentThrowTag"/>
		<exclude name="Squiz.Commenting.ClassComment.Missing"/>
		<exclude name="Squiz.Commenting.FileComment"/>
		<exclude name="Squiz.Commenting.VariableComment.Missing"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
		<!-- This is a CLI tool: output goes to a terminal, not a browser. -->
		<exclude name="WordPress.Security.EscapeOutput"/>
		<!-- Direct queries are the point of the cleanup and report commands. -->
		<exclude name="WordPress.DB.DirectDatabaseQuery"/>
		<exclude name="WordPress.DB.SlowDBQuery"/>
		<!-- Table names come from $wpdb and values always go through prepare(),
		     but the sniff can't tell a table name from user input. -->
		<exclude name="WordPress.DB.PreparedSQL.InterpolatedNotPrepared"/>
		<exclude name="WordPress.DB.PreparedSQL.NotPrepared"/>
		<exclude name="WordPress.WP.AlternativeFunctions"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="groundskeeper"/>
			</property>
		</properties>
	</rule>
</ruleset>
